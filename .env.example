# Copy to .env for local use. Never commit real values.
# --- models (any OpenAI-compatible provider) ---
RAG_PROVIDERS=http
# Answers: Groq free plan (key from https://console.groq.com/keys). 1,000 requests/day per model.
RAG_LLM_BASE_URL=https://api.groq.com/openai/v1
RAG_LLM_MODEL=openai/gpt-oss-120b
# Used in order when the main model's daily limit runs out.
RAG_LLM_FALLBACK_MODELS=openai/gpt-oss-20b
RAG_LLM_REASONING_EFFORT=low
# Minimum seconds between calls; useful for batch evaluation on free per-minute limits (0 = off).
RAG_LLM_MIN_INTERVAL_S=0
RAG_LLM_API_KEY=
# Gemini instead: RAG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai,
# RAG_LLM_MODEL=gemini-flash-latest, RAG_LLM_FALLBACK_MODELS=gemini-flash-lite-latest, RAG_LLM_MIN_INTERVAL_S=13
RAG_EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RAG_EMBED_MODEL=gemini-embedding-2
RAG_EMBED_API_KEY=
RAG_EMBED_DIM=768
# --- optional hosted reranker (Jina); leave all three empty to use the baseline reranker ---
RAG_RERANK_BASE_URL=https://api.jina.ai/v1
RAG_RERANK_MODEL=jina-reranker-v2-base-multilingual
RAG_RERANK_API_KEY=
# --- storage ---
RAG_STORE=pgvector
DATABASE_URL=
# --- API ---
RAG_MIN_RELEVANCE=0.4
RAG_TRUSTED_PROXY_HOPS=1
RAG_RATE_LIMIT_PER_MIN=30
# Uploads are disabled unless both of these are set (admin key >= 24 chars, JWT secret >= 32 chars).
RAG_ADMIN_KEY=
RAG_JWT_SECRET=
