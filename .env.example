# Copy to .env for local use. Never commit real values.
# --- models (any OpenAI-compatible provider; Gemini shown) ---
RAG_PROVIDERS=http
RAG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RAG_LLM_MODEL=gemini-3.8-flash
RAG_LLM_API_KEY=
RAG_EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RAG_EMBED_MODEL=gemini-embedding-2
RAG_EMBED_API_KEY=
RAG_EMBED_DIM=768
# --- optional hosted reranker (Jina); leave all three empty to use the baseline reranker ---
RAG_RERANK_BASE_URL=https://api.jina.ai/v1
RAG_RERANK_MODEL=jina-reranker-v2-base-multilingual
RAG_RERANK_API_KEY=
# --- storage ---
RAG_STORE=pgvector
DATABASE_URL=
# --- API ---
RAG_MIN_RELEVANCE=0.4
RAG_TRUSTED_PROXY_HOPS=1
RAG_RATE_LIMIT_PER_MIN=30
# Uploads are disabled unless both of these are set (admin key >= 24 chars, JWT secret >= 32 chars).
RAG_ADMIN_KEY=
RAG_JWT_SECRET=
